# Maintainer: MoozIiSP <yuaolni@gmail.com>
# DeepSeek dsh CLI — https://github.com/deepseek-ai/deepseek-harness (apps/cli)

pkgname=deepseek-dsh
_realver=0.2.0-rc.2
pkgver=${_realver//-/_}
pkgrel=1
pkgdesc="dsh CLI: profile boot, plugin management, and the browser UI alias (DeepSeek Harness)"
arch=('x86_64')
url="https://github.com/deepseek-ai/deepseek-harness"
license=('MIT')
depends=('nodejs')
makedepends=('npm' 'node-gyp' 'python')
source=("dsh-${_realver}.tgz::https://registry.npmjs.org/@deepseek-ai/dsh/-/dsh-${_realver}.tgz")
sha256sums=('bd27847c445cd68a565ac1f91c06bbbcc7639ef93071f678bb59c5ebaff38859')

package() {
  # Install the dependency tree without executing arbitrary lifecycle scripts.
  cd "${srcdir}"
  npm install \
    --prefix "${pkgdir}/usr" \
    --global \
    --omit=dev \
    --ignore-scripts \
    --cache "${srcdir}/npm-cache" \
    --userconfig=/dev/null \
    "@deepseek-ai/dsh@${_realver}"

  # dsh web requires node-pty. The npm tarball has no Linux prebuild, so build
  # this one audited native dependency explicitly against Arch's Node headers.
  local node_pty="${pkgdir}/usr/lib/node_modules/@deepseek-ai/dsh/node_modules/node-pty"
  cd "${node_pty}"
  node-gyp rebuild --nodedir=/usr
  node scripts/post-install.js
  test -f build/Release/pty.node
}
